# Backend Configuration (entorno local)
DEBUG=True
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Base de datos local en Docker
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=subsonic
MONGO_TIMEOUT_MS=5000

# Sembrar usuarios/eventos/productos de demostración al arrancar
SEED_DEMO_DATA=True

# Sesión y JWT local
SESSION_TIMEOUT=3600
SESSION_COOKIE_SECURE=False
JWT_SECRET=subsonic-dev-secret-change-me
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24

# CORS (frontend servido en localhost)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
EXTRA_ALLOWED_ORIGINS=

# OAuth 2.0 (opcional, modo demo si está vacío)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/#oauth-callback?provider=google
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/#oauth-callback?provider=apple
OAUTH_STATE_SECRET=change-me

# Cifrado de campos sensibles
FIELD_ENCRYPTION_KEY=change-me-in-production

# TLS y cabeceras de seguridad
FORCE_HTTPS=False
HSTS_MAX_AGE=31536000

# SMTP simulado (opcional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@subsonicfest.com
